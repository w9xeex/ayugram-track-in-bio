import threading
import time
import traceback

import requests

from android_utils import log, run_on_ui_thread
from base_plugin import BasePlugin
from client_utils import get_messages_controller, get_user_config, send_request
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text

__id__ = "lastfm_bio"
__name__ = "Track in Bio"
__description__ = "Shows the track you are listening to (via Last.fm) in your Telegram bio and restores the old bio when the music stops."
__author__ = "@w9xeex"
__version__ = "0.3.1"
__icon__ = "uniposting/0"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

LASTFM_URL = "https://ws.audioscrobbler.com/2.0/"
DEFAULT_POLL_SECONDS = 10
MIN_POLL_SECONDS = 5
MAX_POLL_SECONDS = 120
MIN_UPDATE_GAP_SECONDS = 10  # protection from Telegram flood limits
ERROR_COOLDOWN_SECONDS = 60
BIO_LIMIT = 70
STALE_MARGIN_SECONDS = 45     # how long after the expected track end we still trust "now playing"
FALLBACK_TRACK_SECONDS = 300  # used when Last.fm does not know the track length
MIN_TRACK_SECONDS = 60
MAX_TRACK_SECONDS = 1800
REPLAY_GAP_SECONDS = 20
PREFIX = "🎵 "
BACKUP_KEY = "backup_about"

# In different Telegram versions the request class lives under different names
REQUEST_CLASS_NAMES = [
    "org.telegram.tgnet.tl.TL_account$updateProfile",
    "org.telegram.tgnet.TLRPC$TL_account_updateProfile",
]


def parse_now_playing(data):
    """Returns (artist, title, prev_uts) if something is playing right now, otherwise None.
    prev_uts is the start time of the previous scrobble if it was the same track, else 0."""
    tracks = data.get("recenttracks", {}).get("track", [])
    if isinstance(tracks, dict):
        tracks = [tracks]
    if not tracks:
        return None
    track = tracks[0]
    if track.get("@attr", {}).get("nowplaying") != "true":
        return None
    artist = track.get("artist", {}).get("#text", "") or ""
    title = track.get("name", "") or ""
    if not title:
        return None
    prev_uts = 0
    if len(tracks) > 1:
        prev = tracks[1]
        same = (prev.get("artist", {}).get("#text", "") or "") == artist and (prev.get("name", "") or "") == title
        if same:
            try:
                prev_uts = int(prev.get("date", {}).get("uts", 0))
            except Exception:
                prev_uts = 0
    return artist, title, prev_uts


def format_bio(artist, title):
    text = PREFIX + (artist + " - " + title if artist else title)
    if len(text) > BIO_LIMIT:
        text = text[: BIO_LIMIT - 1] + "…"
    return text


class StaleGuard:
    """Stops trusting a 'now playing' status that has lasted longer than the track itself."""

    def __init__(self):
        self.key = None
        self.started = 0
        self.ignored = False

    def clear(self):
        self.key = None
        self.ignored = False

    def update(self, key, prev_uts, now):
        if key != self.key:
            self.key = key
            self.started = now
            self.ignored = False
        elif prev_uts and prev_uts > self.started + REPLAY_GAP_SECONDS:
            # the same track was started again (repeat): a new play began later than we recorded
            self.started = prev_uts
            self.ignored = False

    def check(self, now, duration):
        """True if the track should still be shown."""
        if self.ignored:
            return False
        if now - self.started > duration + STALE_MARGIN_SECONDS:
            self.ignored = True
            return False
        return True


class TrackInBioPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._stop = None
        self._thread = None
        self._shown = None
        self._cooldown_until = 0
        self._last_sent = 0
        self._guard = StaleGuard()
        self._durations = {}

    # ---------- lifecycle ----------
    def on_plugin_load(self):
        if self.get_setting("enabled", False):
            self._start()

    def on_plugin_unload(self):
        self._stop_worker(restore=True)

    # ---------- settings ----------
    def create_settings(self):
        return [
            Header(text="Last.fm"),
            Input(
                key="api_key",
                text="API-ключ Last.fm",
                default="",
                subtext="Получить: last.fm/api/account/create",
                icon="msg_pin_code",
            ),
            Input(
                key="username",
                text="Логин Last.fm",
                default="w9xeex",
                icon="msg_contacts",
            ),
            Header(text="Работа"),
            Input(
                key="poll_seconds",
                text="Интервал проверки, сек",
                default=str(DEFAULT_POLL_SECONDS),
                subtext="От 5 до 120. Чем меньше, тем быстрее реакция",
            ),
            Switch(
                key="enabled",
                text="Показывать трек в био",
                default=False,
                subtext="Трек в био, пока играет музыка",
                icon="msg_edit",
                on_change=self._on_toggle,
            ),
            Text("Проверить Last.fm сейчас", icon="msg_retry", on_click=self.check_now),
            Text("Вернуть прежнее био", icon="msg_undo", on_click=self.restore_now),
            Divider("Перед включением убедись, что в био стоит твой обычный текст, а не прежний трек. Его копия сохраняется перед первой заменой."),
        ]

    def _on_toggle(self, value):
        if value:
            self._start()
        else:
            self._stop_worker(restore=True)

    # ---------- worker ----------
    def _start(self):
        if self._thread is not None and self._thread.is_alive():
            return
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._worker, args=(self._stop,), daemon=True)
        self._thread.start()

    def _stop_worker(self, restore):
        if self._stop is not None:
            self._stop.set()
        self._thread = None
        if restore and self._shown is not None:
            self._restore()

    def _worker(self, stop):
        while not stop.is_set():
            try:
                self._tick()
            except Exception:
                log(traceback.format_exc())
            stop.wait(self._poll_interval())

    def _poll_interval(self):
        try:
            value = int(str(self.get_setting("poll_seconds", str(DEFAULT_POLL_SECONDS))).strip())
        except Exception:
            value = DEFAULT_POLL_SECONDS
        return max(MIN_POLL_SECONDS, min(MAX_POLL_SECONDS, value))

    def _tick(self):
        if time.time() < self._cooldown_until:
            return
        api_key = str(self.get_setting("api_key", "")).strip()
        username = str(self.get_setting("username", "")).strip()
        if not api_key or not username:
            return
        try:
            track = self._fetch_now_playing(api_key, username)
        except Exception as exc:
            log("Last.fm request failed: " + str(exc))
            return
        if track is None:
            self._guard.clear()
            if self._shown is not None:
                self._restore()
            return
        now = time.time()
        self._guard.update(track[0] + "\x00" + track[1], track[2], now)
        if not self._guard.ignored:
            duration = self._duration(api_key, track[0], track[1])
            self._guard.check(now, duration)
        if self._guard.ignored:
            if self._shown is not None:
                self._restore()
            return
        text = format_bio(track[0], track[1])
        if text == self._shown:
            return
        if time.time() - self._last_sent < MIN_UPDATE_GAP_SECONDS:
            return
        if not self._ensure_backup():
            self._cooldown_until = time.time() + ERROR_COOLDOWN_SECONDS
            return
        self._send_bio(text)
        self._shown = text

    # ---------- Last.fm ----------
    def _fetch_now_playing(self, api_key, username):
        resp = requests.get(
            LASTFM_URL,
            params={
                "method": "user.getrecenttracks",
                "user": username,
                "api_key": api_key,
                "format": "json",
                "limit": 2,
            },
            timeout=8,
        )
        resp.raise_for_status()
        data = resp.json()
        if data.get("error"):
            raise RuntimeError("Last.fm: " + str(data.get("message")))
        return parse_now_playing(data)

    def _duration(self, api_key, artist, title):
        cache_key = (artist, title)
        if cache_key in self._durations:
            return self._durations[cache_key]
        seconds = FALLBACK_TRACK_SECONDS
        try:
            resp = requests.get(
                LASTFM_URL,
                params={
                    "method": "track.getInfo",
                    "artist": artist,
                    "track": title,
                    "api_key": api_key,
                    "format": "json",
                    "autocorrect": 1,
                },
                timeout=8,
            )
            resp.raise_for_status()
            millis = int(resp.json().get("track", {}).get("duration", "0") or 0)
            if millis > 0:
                seconds = millis / 1000.0
            seconds = max(MIN_TRACK_SECONDS, min(MAX_TRACK_SECONDS, seconds))
            if len(self._durations) > 200:
                self._durations.clear()
            self._durations[cache_key] = seconds
        except Exception as exc:
            log("track.getInfo failed: " + str(exc))
            seconds = max(MIN_TRACK_SECONDS, min(MAX_TRACK_SECONDS, seconds))
        return seconds

    # ---------- bio ----------
    def _current_about(self):
        try:
            user_id = get_user_config().getClientUserId()
            full = get_messages_controller().getUserFull(user_id)
            if full is not None and full.about is not None:
                return str(full.about)
        except Exception:
            log(traceback.format_exc())
        return None

    def _ensure_backup(self):
        """Saves the user's real bio before the first replacement. False = it is unsafe to continue."""
        if self.get_setting(BACKUP_KEY, None) is not None:
            return True
        current = self._current_about()
        if current is None:
            self._notify_error("Не удалось прочитать текущее био. Открой свой профиль и повтори")
            return False
        if current.startswith(PREFIX):
            self._notify_error("В био уже трек. Верни обычный текст вручную и включи заново")
            return False
        self.set_setting(BACKUP_KEY, current)
        return True

    def _make_request(self):
        for name in REQUEST_CLASS_NAMES:
            try:
                cls = find_class(name)
            except Exception:
                cls = None
            if cls is not None:
                return cls()
        raise RuntimeError("класс updateProfile не найден")

    def _send_bio(self, text):
        self._last_sent = time.time()
        try:
            req = self._make_request()
            req.flags = req.flags | 4  # 4 = the "about" field is set
            req.about = text
        except Exception:
            log(traceback.format_exc())
            return

        def on_response(response, error):
            if error:
                log("updateProfile error: " + str(error.text))
                self._shown = None
                self._cooldown_until = time.time() + ERROR_COOLDOWN_SECONDS

        try:
            send_request(req, on_response)
        except Exception:
            log(traceback.format_exc())

    def _restore(self):
        backup = self.get_setting(BACKUP_KEY, None)
        self._shown = None
        if backup is not None:
            self._send_bio(str(backup))

    def _notify_error(self, text):
        run_on_ui_thread(lambda: BulletinHelper.show_error(text))

    # ---------- buttons ----------
    def check_now(self, view=None):
        api_key = str(self.get_setting("api_key", "")).strip()
        username = str(self.get_setting("username", "")).strip()
        if not api_key or not username:
            BulletinHelper.show_error("Впиши API-ключ и логин Last.fm")
            return

        def job():
            try:
                track = self._fetch_now_playing(api_key, username)
            except Exception as exc:
                msg = "Last.fm: " + str(exc)
                run_on_ui_thread(lambda: BulletinHelper.show_error(msg[:150]))
                return
            if track is None:
                run_on_ui_thread(lambda: BulletinHelper.show_info("Сейчас ничего не играет"))
            else:
                msg = "Играет: " + format_bio(track[0], track[1])
                run_on_ui_thread(lambda: BulletinHelper.show_success(msg))

        threading.Thread(target=job, daemon=True).start()

    def restore_now(self, view=None):
        if self.get_setting(BACKUP_KEY, None) is None:
            BulletinHelper.show_error("Нет сохранённого био")
            return
        self._restore()
        BulletinHelper.show_success("Прежнее био возвращено")
